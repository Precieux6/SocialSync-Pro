{
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node",
      "config": { "maxDuration": 60 }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "src/server.js" }
  ],
  "crons": [
    { "path": "/api/internal/content-job", "schedule": "0 5 * * *" },
    { "path": "/api/internal/scripts-job", "schedule": "30 5 * * *" },
    { "path": "/api/internal/reminders", "schedule": "0 16 * * *" }
  ]
}
