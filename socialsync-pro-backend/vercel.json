{
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node",
      "config": { "maxDuration": 300 }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "src/server.js" }
  ],
  "crons": [
    { "path": "/api/internal/content-job", "schedule": "0 */3 * * *" },
    { "path": "/api/internal/publish-due", "schedule": "*/10 * * * *" }
  ]
}
